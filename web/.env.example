# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Dashboard -> Project Settings -> API Keys / Data API.
#
# Both values are PUBLIC and end up in the browser bundle. That is expected:
# Row Level Security protects the data.
#
# NEVER add the service role / secret key here (or anywhere with a VITE_ prefix).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
